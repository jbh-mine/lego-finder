HOST=0.0.0.0
PORT=8080
DB_PATH=/data/market.sqlite
ALLOW_ORIGINS=https://jbh-mine.github.io
# Set to 1 only on a private network behind one trusted proxy; never expose that API port publicly.
TRUST_PROXY=0
BRICKLINK_CONSUMER_KEY=
BRICKLINK_CONSUMER_SECRET=
BRICKLINK_TOKEN_VALUE=
BRICKLINK_TOKEN_SECRET=
ADMIN_TOKEN=
# Docker secrets: omit a direct variable to use the corresponding *_FILE.
# BRICKLINK_CONSUMER_KEY_FILE=/run/secrets/bricklink_consumer_key
# BRICKLINK_CONSUMER_SECRET_FILE=/run/secrets/bricklink_consumer_secret
# BRICKLINK_TOKEN_VALUE_FILE=/run/secrets/bricklink_token_value
# BRICKLINK_TOKEN_SECRET_FILE=/run/secrets/bricklink_token_secret
# ADMIN_TOKEN_FILE=/run/secrets/admin_token
CACHE_TTL_SECONDS=21600
DAILY_PROVIDER_BUDGET=4500
PROVIDER_MIN_INTERVAL_MS=1000
PROVIDER_TIMEOUT_MS=10000
SCHEDULER_INTERVAL_SECONDS=900
OBSERVATION_RETENTION_DAYS=730
