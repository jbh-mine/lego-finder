# Copy to private .env next to hosting-entry.mjs; never publish credentials.
# HOST/IP and PORT come from the Node.js website configuration.
DB_PATH=./data/market.sqlite
ALLOW_ORIGINS=https://jbh-mine.github.io
TRUST_PROXY=0
BRICKLINK_CONSUMER_KEY=
BRICKLINK_CONSUMER_SECRET=
BRICKLINK_TOKEN_VALUE=
BRICKLINK_TOKEN_SECRET=
ADMIN_TOKEN=
DAILY_PROVIDER_BUDGET=1200
MAX_WATCHED_SCOPES=50
MAX_PROVIDER_QUEUE=8
SCHEDULER_BATCH_SIZE=4
CACHE_TTL_SECONDS=21600
SCHEDULER_INTERVAL_SECONDS=900
OBSERVATION_RETENTION_DAYS=730
